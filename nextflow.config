/*
 * nf-params-probe
 *
 * Every param below is deliberately placed in a different relationship to
 * nextflow_schema.json, so that one run tells you what the launch form did
 * to each of them. The value 'CONFIG' means "this file supplied it".
 * The schema supplies 'SCHEMA'. Anything that arrives as null was nulled
 * in transit.
 */

params {
    // 1. In this file, absent from the schema.
    //    Mirrors params.registry in FD-7826: the form has no field for it.
    p1_config_only        = 'CONFIG'

    // 2. Null here, real default in the schema.
    //    Mirrors params.outdir in FD-7826.
    p2_config_null        = null

    // 3. In both, same value. Control: nothing should disturb this.
    p3_agree              = 'CONFIG'

    // 4. In both, different values. Shows which side the form takes.
    p4_disagree           = 'CONFIG'

    // 5. Null here, absent from the schema.
    p5_config_only_null   = null

    // 6. Deliberately NOT declared here; the schema declares it with a default.
    //    Reading it warns "Access to undefined parameter" if the form drops it.

    // 7. Empty here, required by the schema, no default. The user types this one.
    p7_user_input         = ''
}

process {
    // Trivial local work; costs nothing on any compute environment.
    cpus   = 1
    memory = 1.GB
}

manifest {
    name            = 'nf-params-probe'
    description     = 'Reports where each parameter value came from, to expose params-file nulls (FD-7826)'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}
